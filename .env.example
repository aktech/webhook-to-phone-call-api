# Secret token for authenticating webhook calls
TOKEN=your-secret-token-here

# Twilio Account SID (find at https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key SID (create at https://console.twilio.com/us1/develop/runtime/api-keys)
# Recommended for production instead of Auth Token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key Secret (shown only once when created)
TWILIO_API_KEY_SECRET=your-api-key-secret-here

# Your Twilio phone number in E.164 format (e.g., +14155551234)
TWILIO_FROM_NUMBER=+1234567890

# Phone number to call when alert is triggered
ALERT_TO_NUMBER=+1234567890

# Port to run the service on (optional, defaults to 8080)
PORT=8080
